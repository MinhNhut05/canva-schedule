# SileTravel - Environment Variables
# Copy this file to .env and fill in the values
# IMPORTANT: Never use NEXT_PUBLIC_ prefix for secrets

# === Required at startup ===
AUTH_SECRET=           # NextAuth.js secret (openssl rand -base64 32)
DATABASE_URL=          # PostgreSQL connection string

# === AI Integration ===
AI_API_URL=            # AI service endpoint
AI_API_KEY=            # AI service API key
AI_MODEL=              # AI extraction model name (default: oc/deepseek-v4-flash-free)
AI_REASONING_EFFORT=   # Reasoning effort for extraction: low | medium | high (default: medium)
AI_IMAGE_MODEL=        # AI image model name (default: cx/gpt-5.5-image)

# === Object Storage (S3 / Cloudflare R2) ===
# Used by /image-gen feature to persist generated images.
S3_ENDPOINT=           # https://<account>.r2.cloudflarestorage.com (R2) or leave empty for AWS S3
S3_REGION=             # auto (R2) or AWS region like us-east-1
S3_BUCKET=             # Bucket name
S3_ACCESS_KEY_ID=      # Access key ID
S3_SECRET_ACCESS_KEY=  # Secret access key
S3_PUBLIC_URL=         # Public base URL for objects, e.g. https://cdn.example.com

# === Canva Integration ===
CANVA_CLIENT_ID=       # Canva Developer App client ID
CANVA_CLIENT_SECRET=   # Canva Developer App client secret
CANVA_ACCESS_TOKEN=    # Canva OAuth access token
CANVA_REFRESH_TOKEN=   # Canva OAuth refresh token
CANVA_TEMPLATE_1DAY_ITINERARY= # Canva template ID for 1-day tour itinerary
CANVA_TEMPLATE_1DAY_MENU=      # Canva template ID for 1-day tour menu
CANVA_TEMPLATE_2DAY_ITINERARY= # Canva template ID for 2-day tour itinerary
CANVA_TEMPLATE_2DAY_MENU=      # Canva template ID for 2-day tour menu
CANVA_TEMPLATE_3DAY_ITINERARY= # Canva template ID for 3-day tour itinerary
CANVA_TEMPLATE_3DAY_MENU=      # Canva template ID for 3-day tour menu
CANVA_TEMPLATE_4DAY_ITINERARY= # Canva template ID for 4-day tour itinerary
CANVA_TEMPLATE_4DAY_MENU=      # Canva template ID for 4-day tour menu (add when ready)
CANVA_SHARE_WORKER_POLL_MS=5000 # Poll interval for the Canva share worker
CANVA_SHARE_DRY_RUN=true        # Keep true until the real Canva UI bot is configured
CANVA_BOT_STORAGE_STATE_PATH=   # Path to Playwright storageState JSON for the Canva bot account
CANVA_BOT_USER_AGENT=           # Chrome User-Agent of the login session (printed by `pnpm canva:bot-login`); required so the worker matches cf_clearance and passes Cloudflare
CANVA_BOT_HEADLESS=false        # Must be false: Canva rejects share mutations from headless browsers. Run headed locally, or under xvfb on a server.
