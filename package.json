    "mammoth": "^1.12.0",
    "next": "^15.3.1",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^6.32.0",
    "pdfjs-dist": "^5.5.207",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.0"
