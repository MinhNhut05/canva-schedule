generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_WARNING
  FAILED
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  uploads            Upload[]

  @@map("users")
}

model Upload {
  id               String       @id @default(cuid())
  userId           String
  originalFileName String
  detectedMime     String?
  sourceKind       String?
  sizeBytes        Int
  status           UploadStatus @default(PENDING)
  rawText          String?      @db.Text
  normalizedText   String?      @db.Text
  qualityScore     Float?
  qualityLevel     String?
  qualityFlags     String[]     @default([])
  warningMessages  String[]     @default([])
  errorMessage     String?
  processingTimeMs Int?

  // --- Phase 3: AI Extraction & Review ---
  aiStatus         String?      // PENDING | PROCESSING | READY_FOR_REVIEW | FAILED
  reviewStatus     String?      // PENDING_REVIEW | REVIEWED | APPROVED
  structuredDraft  Json?
  reviewFlags      Json?
  aiModel          String?
  aiAttemptCount   Int          @default(0)
  approvedAt       DateTime?
  clientType       String?      // SCHOOL | GROUP
  tourDuration     String?      // ONE_DAY | TWO_DAY
  aiErrorMessage   String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("uploads")
}

model CompanyRule {
  id          String   @id @default(cuid())
  ruleId      String   @unique
  name        String
  description String
  category    String
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_rules")
}
